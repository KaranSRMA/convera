{
  "manifest_version": 3,
  "name": "Convera",
  "version": "1.0.0",
  "description": "AI reply suggestions",
  "permissions": [
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Convera"
  },
  "icons": {
    "128": "icon-128x128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}